# Opcional: o sistema já vem com os valores do projeto Supabase do escritório.
# Use estas variáveis só se for apontar para outro projeto.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Ligação com o Google (Drive e Agenda) — configurar só na Vercel, nunca no código
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave secreta do Supabase (sb_secret_...) — só no servidor
SUPABASE_SECRET_KEY=

# Atualização diária dos processos (Vercel Cron): qualquer texto longo e aleatório
CRON_SECRET=
# Opcional: só se o CNJ trocar a chave pública do DataJud
DATAJUD_API_KEY=
